\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Derivation of the 5\% hardship threshold via the empirical Cumulative Distribution Function (CDF). The threshold $\tau _{5\%}$ explicitly isolates the hardest queries on a single axis.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:cdf}{{1}{2}{Derivation of the 5\% hardship threshold via the empirical Cumulative Distribution Function (CDF). The threshold $\tau _{5\%}$ explicitly isolates the hardest queries on a single axis}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Three-stage Hard-First Sampling pipeline. \textbf  {Stage~1}: A pool of $N_{pool}=30{,}000$ random vectors is probed cheaply to compute CV and Convergence for every candidate. \textbf  {Stage~2}: The intersection of the bottom-5\% tails is extracted as the Hard Set $\mathcal  {H}$ ($\approx $75 queries, all unconditionally retained); the remaining $\mathcal  {P} \setminus \mathcal  {H}$ forms the easy complement available for backfill. \textbf  {Stage~3}: All hard queries are emitted first (red); the budget is then topped up by drawing uniformly from the easy complement (blue) until $N_{sample}=3{,}000$ is reached.}}{2}{figure.caption.2}\protected@file@percent }
\newlabel{fig:pool_reduction}{{2}{2}{Three-stage Hard-First Sampling pipeline. \textbf {Stage~1}: A pool of $N_{pool}=30{,}000$ random vectors is probed cheaply to compute CV and Convergence for every candidate. \textbf {Stage~2}: The intersection of the bottom-5\% tails is extracted as the Hard Set $\mathcal {H}$ ($\approx $75 queries, all unconditionally retained); the remaining $\mathcal {P} \setminus \mathcal {H}$ forms the easy complement available for backfill. \textbf {Stage~3}: All hard queries are emitted first (red); the budget is then topped up by drawing uniformly from the easy complement (blue) until $N_{sample}=3{,}000$ is reached}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Two-dimensional metric intersection. The dashed lines represent the independent 5\% thresholds. Red points residing in the bottom-left quadrant ($\mathcal  {H}$) strictly satisfy both hardship criteria and are prioritized. The blue points illustrate the uniform backfill sampling to reach the target budget $N_{sample}$.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:scatter}{{3}{3}{Two-dimensional metric intersection. The dashed lines represent the independent 5\% thresholds. Red points residing in the bottom-left quadrant ($\mathcal {H}$) strictly satisfy both hardship criteria and are prioritized. The blue points illustrate the uniform backfill sampling to reach the target budget $N_{sample}$}{figure.caption.3}{}}
